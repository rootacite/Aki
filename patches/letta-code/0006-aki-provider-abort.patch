diff --git a/src/backend/dev/provider-turn-executor-abort.test.ts b/src/backend/dev/provider-turn-executor-abort.test.ts
new file mode 100644
--- /dev/null
+++ b/src/backend/dev/provider-turn-executor-abort.test.ts
@@ -0,0 +1,53 @@
+import { expect, test } from "bun:test";
+import { ProviderTurnExecutor } from "./provider-turn-executor";
+import type {
+  ProviderStreamAdapter,
+  ProviderTurnInput,
+} from "./provider-turn-executor";
+
+test("aborts the provider request when the wrapper stream is cancelled", async () => {
+  let captured: AbortSignal | undefined;
+  const adapter: ProviderStreamAdapter = {
+    async stream(input: ProviderTurnInput) {
+      captured = input.abortSignal;
+      return (async function* () {
+        yield {
+          type: "letta-chunk",
+          chunk: { message_type: "assistant_message", content: [] },
+        } as never;
+        await new Promise<void>((resolve) => {
+          if (input.abortSignal?.aborted) return resolve();
+          input.abortSignal?.addEventListener("abort", () => resolve(), {
+            once: true,
+          });
+        });
+        yield {
+          type: "letta-chunk",
+          chunk: { message_type: "stop_reason", stop_reason: "end_turn" },
+        } as never;
+      })();
+    },
+  };
+  const executor = new ProviderTurnExecutor(adapter);
+  const stream = await executor.execute({
+    conversationId: "default",
+    agentId: "agent-test",
+    agent: {
+      id: "agent-test",
+      name: "Test",
+      system: "system",
+      tags: [],
+      model: "test/model",
+      model_settings: {},
+    },
+    body: { messages: [] } as never,
+    history: [],
+    uiMessages: [],
+  });
+  const iterator = stream[Symbol.asyncIterator]();
+  await iterator.next();
+  stream.controller.abort();
+  await new Promise((resolve) => setTimeout(resolve, 0));
+  expect(captured?.aborted).toBe(true);
+  await iterator.return?.();
+});
