 let activeTurn: AkiTurnState | null = null;
 
+const SUPPRESSED_REMINDER_MARKERS = [
+  "automated message providing context about the user's environment",
+  "automated message providing information about you",
+  "MCP servers with available tools:",
+  "Permission mode active:",
+  "Permission mode changed to:",
+] as const;
+
+const SYSTEM_REMINDER_BLOCK_RE =
+  /<system-reminder>[\s\S]*?<\/system-reminder>/g;
+
+function stripSuppressedReminderText(text: string): string {
+  let changed = false;
+  const updated = text.replace(SYSTEM_REMINDER_BLOCK_RE, (block) => {
+    if (
+      !SUPPRESSED_REMINDER_MARKERS.some((marker) => block.includes(marker))
+    ) {
+      return block;
+    }
+    changed = true;
+    return "";
+  });
+  if (!changed) return text;
+  const trimmed = updated
+    .replace(/^[ \t]*(?:\r?\n)+/, "")
+    .replace(/(?:\r?\n)+[ \t]*$/, "");
+  return trimmed.trim() ? trimmed : "";
+}
+
+/**
+ * Remove the four historical Letta reminders that Aki now renders itself.
+ * Functional reminders (agent messages, memory maintenance, tasks, empty
+ * responses) are deliberately preserved.
+ */
+export function stripSuppressedLettaReminders(
+  messages: readonly LocalMessage[],
+): LocalMessage[] {
+  let changed = false;
+  const output: LocalMessage[] = [];
+  for (const message of messages) {
+    if (message.role !== "user") {
+      output.push(message);
+      continue;
+    }
+    const content = message.content;
+    if (typeof content === "string") {
+      const text = stripSuppressedReminderText(content);
+      if (text !== content) changed = true;
+      if (!text) continue;
+      output.push(
+        text === content ? message : ({ ...message, content: text } as LocalUserMessage),
+      );
+      continue;
+    }
+    if (!Array.isArray(content)) {
+      output.push(message);
+      continue;
+    }
+    type LocalUserContent = Exclude<LocalUserMessage["content"], string>;
+    const parts: LocalUserContent = [];
+    let messageChanged = false;
+    for (const part of content) {
+      if (
+        part !== null &&
+        typeof part === "object" &&
+        (part as { type?: unknown }).type === "text" &&
+        typeof (part as { text?: unknown }).text === "string"
+      ) {
+        const original = (part as { text: string }).text;
+        const text = stripSuppressedReminderText(original);
+        if (text !== original) messageChanged = true;
+        if (!text) continue;
+        parts.push(
+          text === original
+            ? part
+            : ({ ...part, text } as (typeof parts)[number]),
+        );
+        continue;
+      }
+      parts.push(part as (typeof parts)[number]);
+    }
+    if (messageChanged) changed = true;
+    if (parts.length === 0) continue;
+    output.push(
+      messageChanged
+        ? ({ ...message, content: parts } as LocalUserMessage)
+        : message,
+    );
+  }
+  return changed ? output : (messages as LocalMessage[]);
+}
