+function prefixUserContent(
+  content: LocalUserMessage["content"],
+  prefix: string,
+): LocalUserMessage["content"] {
+  if (typeof content === "string") {
+    return content.trim() ? `${prefix}\n\n${content}` : prefix;
+  }
+  return [{ type: "text", text: `${prefix}\n\n` }, ...content];
+}
+
+function prependUserMessagePrefix(
+  messages: readonly LocalMessage[],
+  prefix: string | undefined,
+): LocalMessage[] {
+  const text = prefix?.trim();
+  if (!text) return messages as LocalMessage[];
+  for (let index = messages.length - 1; index >= 0; index -= 1) {
+    const message = messages[index];
+    if (!message || message.role !== "user") continue;
+    const next = [...messages];
+    next[index] = {
+      ...message,
+      content: prefixUserContent(message.content, text),
+    } as LocalUserMessage;
+    return next;
+  }
+  return messages as LocalMessage[];
+}
