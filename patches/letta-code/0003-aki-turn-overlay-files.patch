+export async function applyAkiProviderOverlayWithFiles(
+  input: ProviderTurnInput,
+): Promise<ProviderTurnInput> {
+  const state = activeTurn;
+  if (!state) return input;
+  const insertions = await claimAkiOverlayFiles(state.turnId);
+  if (insertions.length > 0) {
+    const known = new Set(state.turnInsertions.map((item) => item.id));
+    for (const insertion of insertions) {
+      if (known.has(insertion.id)) continue;
+      known.add(insertion.id);
+      state.turnInsertions.push(insertion);
+    }
+    state.turnInsertions.sort(
+      (left, right) =>
+        left.insertedAtMs - right.insertedAtMs ||
+        left.seq - right.seq ||
+        left.id.localeCompare(right.id),
+    );
+  }
+  return applyAkiProviderOverlay(input);
 }
 
