+/**
+ * Claim akid's per-message overlay files at the provider request boundary.
+ * Files are sorted by seq and deleted only after they were parsed and queued.
+ * Invalid or foreign-turn files stay on disk so akid can preserve them.
+ */
+export async function claimAkiOverlayFiles(
+  turnId: string,
+): Promise<AkiInsertion[]> {
+  const root = process.env.AKI_TURN_OVERLAY_DIR?.trim();
+  if (!root || !turnId) return [];
+  const directory = join(root, turnId);
+  let names: string[];
+  try {
+    names = await readdir(directory);
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException).code;
+    if (code !== "ENOENT") {
+      console.error(
+        `[aki-overlay-files] cannot read ${directory}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+    }
+    return [];
+  }
+  const records: Array<{
+    name: string;
+    path: string;
+    seq: number;
+    insertedAtMs: number;
+    id: string;
+    content: string;
+    record: AkiOverlayFileRecord;
+  }> = [];
+  for (const name of names.filter((candidate) => candidate.endsWith(".json"))) {
+    const path = join(directory, name);
+    let raw: string;
+    try {
+      raw = await readFile(path, "utf8");
+    } catch (error) {
+      console.error(
+        `[aki-overlay-files] cannot read ${path}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+      continue;
+    }
+    let record: AkiOverlayFileRecord;
+    try {
+      record = JSON.parse(raw) as AkiOverlayFileRecord;
+    } catch (error) {
+      console.error(
+        `[aki-overlay-files] invalid JSON in ${path}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+      continue;
+    }
+    if (String(record.turn_id ?? "") !== turnId) {
+      console.error(
+        `[aki-overlay-files] ignoring ${path}: turn_id=${
+          String(record.turn_id ?? "")
+        } active=${turnId}`,
+      );
+      continue;
+    }
+    const seq = Number(record.seq);
+    if (!Number.isFinite(seq)) {
+      console.error(`[aki-overlay-files] ignoring ${path}: invalid seq`);
+      continue;
+    }
+    const content = overlayFileContentText(record.content);
+    if (content === null) {
+      console.error(`[aki-overlay-files] ignoring ${path}: missing content`);
+      continue;
+    }
+    let insertedAtMs = Number(record.inserted_at_ms);
+    if (!Number.isFinite(insertedAtMs)) {
+      const parsed = Date.parse(String(record.inserted_at ?? ""));
+      insertedAtMs = Number.isFinite(parsed) ? parsed : seq;
+    }
+    const id =
+      String(record.insertion_id ?? "").trim() || `overlay-${name}`;
+    records.push({ name, path, seq, insertedAtMs, id, content, record });
+  }
+  records.sort(
+    (left, right) =>
+      left.insertedAtMs - right.insertedAtMs ||
+      left.seq - right.seq ||
+      left.name.localeCompare(right.name),
+  );
+  const insertions: AkiInsertion[] = [];
+  for (const entry of records) {
+    insertions.push({
+      id: entry.id,
+      seq: entry.seq,
+      insertedAtMs: entry.insertedAtMs,
+      content: entry.content,
+    });
+    try {
+      await unlink(entry.path);
+    } catch (error) {
+      console.error(
+        `[aki-overlay-files] delivered but could not consume ${entry.path}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+    }
+  }
+  return insertions;
+}
