diff --git a/src/backend/local/aki-conversation-state.test.ts b/src/backend/local/aki-conversation-state.test.ts
new file mode 100644
index 0000000..1ec091d
--- /dev/null
+++ b/src/backend/local/aki-conversation-state.test.ts
@@ -0,0 +1,130 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { LocalStore } from "@/backend/local/local-store";
+
+let root: string | null = null;
+
+afterEach(async () => {
+  if (root) {
+    await rm(root, { recursive: true, force: true });
+    root = null;
+  }
+});
+
+async function storeWithConversation(): Promise<{
+  store: LocalStore;
+  conversationId: string;
+}> {
+  root = await mkdtemp(join(tmpdir(), "aki-conversation-state-"));
+  const store = new LocalStore("agent-test", { storageDir: root });
+  const conversation = store.createConversation({ agent_id: "agent-test" });
+  return { store, conversationId: conversation.id };
+}
+
+function appendUser(store: LocalStore, conversationId: string, text: string): void {
+  store.appendTurnInput(conversationId, {
+    agent_id: "agent-test",
+    messages: [{ role: "user", content: text }],
+  } as never);
+}
+
+function conversationDir(conversationId: string): string {
+  const key = `conversation:${conversationId}`;
+  return join(
+    root as string,
+    "conversations",
+    Buffer.from(key).toString("base64url"),
+  );
+}
+
+describe("Aki conversation state bridge", () => {
+  test("snapshots and restores the logical message list in-process", async () => {
+    const { store, conversationId } = await storeWithConversation();
+    appendUser(store, conversationId, "first");
+    const snapshot = store.snapshotConversation(conversationId, "agent-test");
+    appendUser(store, conversationId, "second");
+    expect(store.listLocalMessages(conversationId)).toHaveLength(2);
+
+    const restored = store.restoreConversation(snapshot.snapshot_id);
+    expect(restored).toMatchObject({ restored: true, message_count: 1 });
+    expect(store.listLocalMessages(conversationId)).toHaveLength(1);
+    const raw = await readFile(
+      join(conversationDir(conversationId), "messages.jsonl"),
+      "utf8",
+    );
+    expect(raw).toContain("first");
+    expect(raw).not.toContain("second");
+  });
+
+  test("reloads a resident conversation from disk without restarting", async () => {
+    const { store, conversationId } = await storeWithConversation();
+    appendUser(store, conversationId, "first");
+    expect(store.listLocalMessages(conversationId)).toHaveLength(1);
+    const reloaded = store.reloadConversationFromDisk(
+      conversationId,
+      "agent-test",
+    );
+    expect(reloaded).toMatchObject({ reloaded: true, message_count: 1 });
+    expect(store.listLocalMessages(conversationId)[0]?.content).toEqual([
+      { type: "text", text: "first" },
+    ]);
+  });
+
+  test("snapshots full history beyond the resident window", async () => {
+    const { store, conversationId } = await storeWithConversation();
+    for (let index = 0; index < 120; index += 1) {
+      appendUser(store, conversationId, `message-${index}`);
+    }
+    const ids = store.listLocalMessages(conversationId).map((message) => message.id);
+    expect(ids).toHaveLength(120);
+    const recordPath = join(conversationDir(conversationId), "conversation.json");
+    const record = JSON.parse(await readFile(recordPath, "utf8")) as Record<string, unknown>;
+    record.in_context_message_ids = ids.slice(-10);
+    await writeFile(recordPath, `${JSON.stringify(record, null, 2)}\n`, "utf8");
+
+    store.reloadConversationFromDisk(conversationId, "agent-test");
+    const snapshot = store.snapshotConversation(conversationId, "agent-test");
+    expect(snapshot.message_count).toBe(120);
+  });
+
+  test("restore preserves compaction entries", async () => {
+    const { store, conversationId } = await storeWithConversation();
+    appendUser(store, conversationId, "before-compaction");
+    const path = join(conversationDir(conversationId), "messages.jsonl");
+    const rows = (await readFile(path, "utf8"))
+      .split("\n")
+      .filter((line) => line.trim())
+      .map((line) => JSON.parse(line) as Record<string, unknown>);
+    const last = rows.at(-1) as Record<string, unknown>;
+    rows.push({
+      type: "compaction",
+      id: "compact-entry",
+      parentId: last.id,
+      timestamp: new Date().toISOString(),
+      summary: "compacted summary",
+      firstKeptEntryId: null,
+      tokensBefore: 42,
+      message: {
+        id: "ui-msg-compaction-summary",
+        role: "assistant",
+        content: [{ type: "text", text: "compacted summary" }],
+        timestamp: Date.now(),
+      },
+    });
+    await writeFile(
+      path,
+      `${rows.map((row) => JSON.stringify(row)).join("\n")}\n`,
+      "utf8",
+    );
+    store.reloadConversationFromDisk(conversationId, "agent-test");
+    const snapshot = store.snapshotConversation(conversationId, "agent-test");
+    store.restoreConversation(snapshot.snapshot_id);
+    const restored = (await readFile(path, "utf8"))
+      .split("\n")
+      .filter((line) => line.trim())
+      .map((line) => JSON.parse(line) as Record<string, unknown>);
+    expect(restored.some((row) => row.type === "compaction")).toBe(true);
+  });
+});
