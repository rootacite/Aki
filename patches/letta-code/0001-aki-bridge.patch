+  /**
+   * Explicitly discard the resident conversation window and reload it from
+   * disk. Used by the Aki bridge instead of external file edits + restarts.
+   */
+  reloadConversationFromDisk(
+    conversationId: string,
+    agentId: string,
+  ): { reloaded: true; message_count: number } {
+    const key = this.conversationKey(conversationId, agentId);
+    const conversationDir = this.conversationDirForKey(key);
+    if (!conversationDir) {
+      return {
+        reloaded: true,
+        message_count: this.localMessagesForConversation(conversationId, agentId)
+          .length,
+      };
+    }
+    const recordJson = readFileSync(join(conversationDir, "conversation.json"), "utf8");
+    const conversation = parsePersistedLocalConversation(recordJson, (id) =>
+      this.executionAgentIdForConversation(id),
+    );
+    if (!conversation) {
+      throw new Error(`cannot parse conversation ${conversationId}`);
+    }
+    this.localMessagesByConversationKey.delete(key);
+    this.loadedConversationKeys.delete(key);
+    this.tailResidentConversationKeys.delete(key);
+    this.residentTailStartIndexByConversationKey.delete(key);
+    this.unreadTranscriptHeadBytesByKey.delete(key);
+    this.transcriptMetadataByConversationKey.delete(key);
+    this.compiledSystemPromptByConversationKey.delete(key);
+    this.conversations.set(key, conversation);
+    this.conversationRecordJsonByKey.set(key, recordJson);
+    this.transcriptMetadataRecord(key, conversationDir);
+    this.loadConversationMessageTail(key, conversation.id, agentId);
+    this.rebuildMessageIndex();
+    return {
+      reloaded: true,
+      message_count: this.localMessagesForConversation(conversation.id, agentId)
+        .length,
+    };
+  }
+
+  /** Capture the exact logical message list for an in-process Aki rollback. */
+  snapshotConversation(
+    conversationId: string,
+    agentId: string,
+  ): { snapshot_id: string; message_count: number; updated_at: string } {
+    const conversation = this.retrieveConversation(
+      conversationId,
+      agentId,
+    ) as StoredConversation;
+    const messages = this.localMessagesForConversation(
+      conversation.id,
+      agentId,
+    ).map((message) => cloneLocalMessage(message));
+    this.pruneAkiSnapshots();
+    const snapshotId = `aki-snap-${randomUUID()}`;
+    this.akiConversationSnapshots.set(snapshotId, {
+      snapshotId,
+      conversationId: conversation.id,
+      agentId,
+      conversation: JSON.parse(JSON.stringify(conversation)) as StoredConversation,
+      messages,
+      createdAtMs: Date.now(),
+    });
+    return {
+      snapshot_id: snapshotId,
+      message_count: messages.length,
+      updated_at: String(conversation.updated_at ?? ""),
+    };
+  }
+
+  /** Restore a previously captured logical message list and rewrite its transcript. */
+  restoreConversation(
+    snapshotId: string,
+  ): { restored: true; message_count: number; conversation_id: string } {
+    this.pruneAkiSnapshots();
+    const snapshot = this.akiConversationSnapshots.get(snapshotId);
+    if (!snapshot) {
+      throw new Error(`unknown Aki conversation snapshot: ${snapshotId}`);
+    }
+    const key = this.conversationKey(snapshot.conversationId, snapshot.agentId);
+    const messages = snapshot.messages.map((message) => cloneLocalMessage(message));
+    const conversation: StoredConversation = {
+      ...(JSON.parse(JSON.stringify(snapshot.conversation)) as StoredConversation),
+      updated_at: currentIsoTimestamp(),
+    };
+    this.conversations.set(key, conversation);
+    this.localMessagesByConversationKey.set(key, messages);
+    this.markConversationFullyResident(key);
+    this.persistConversationState(conversation.id, snapshot.agentId, {
+      transcript: "rewrite",
+    });
+    this.rebuildMessageIndex();
+    this.akiConversationSnapshots.delete(snapshotId);
+    return {
+      restored: true,
+      message_count: messages.length,
+      conversation_id: conversation.id,
+    };
+  }
+
+  private pruneAkiSnapshots(): void {
+    const cutoff = Date.now() - AKI_SNAPSHOT_TTL_MS;
+    for (const [snapshotId, snapshot] of this.akiConversationSnapshots) {
+      if (snapshot.createdAtMs < cutoff) {
+        this.akiConversationSnapshots.delete(snapshotId);
+      }
+    }
+  }
