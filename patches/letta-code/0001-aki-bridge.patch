+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  akiBridgeCapabilities,
+  applyAkiProviderOverlay,
+  beginAkiTurn,
+  captureAkiProviderCall,
+  endAkiTurn,
+  updateAkiTurn,
+} from "@/aki/bridge";
+import type { ProviderTurnInput } from "@/backend/dev/provider-turn-executor";
+
+function input(): ProviderTurnInput {
+  return {
+    conversationId: "default",
+    agentId: "agent-test",
+    agent: {
+      id: "agent-test",
+      name: "Test",
+      system: "base system",
+      tags: [],
+      model: "openai/gpt-test",
+      model_settings: {},
+    },
+    systemPrompt: "base system",
+    body: { messages: [] } as never,
+    history: [],
+    uiMessages: [],
+    clientTools: [],
+    clientSkills: [],
+  };
+}
+
+afterEach(() => {
+  endAkiTurn("turn-1");
+  endAkiTurn("turn-2");
+});
+
+describe("Aki bridge", () => {
+  test("advertises its wire capabilities", () => {
+    expect(akiBridgeCapabilities()).toMatchObject({
+      version: 1,
+      features: [
+        "turn_overlay",
+        "conversation_reload",
+        "conversation_snapshot",
+        "conversation_restore",
+      ],
+    });
+  });
+
+  test("replays turn_context on every provider request", () => {
+    beginAkiTurn("turn-1", {
+      turn_context: {
+        system_append: "<channel-turn>context</channel-turn>",
+        user_messages: [{ content: "ephemeral context" }],
+      },
+    });
+    const first = applyAkiProviderOverlay(input());
+    const second = applyAkiProviderOverlay(input());
+    expect(first.systemPrompt).toBe(
+      "base system\n\n<channel-turn>context</channel-turn>",
+    );
+    expect(first.uiMessages).toHaveLength(1);
+    expect(second.uiMessages).toHaveLength(1);
+    expect(first.uiMessages[0]?.content).toEqual([
+      { type: "text", text: "ephemeral context" },
+    ]);
+  });
+
+  test("delivers interjections once at the next request boundary", () => {
+    beginAkiTurn("turn-1", {});
+    updateAkiTurn("turn-1", {
+      interjection: { user_messages: [{ content: "interjection" }] },
+    });
+    const first = applyAkiProviderOverlay(input());
+    const second = applyAkiProviderOverlay(input());
+    expect(first.uiMessages).toHaveLength(1);
+    expect(second.uiMessages).toHaveLength(0);
+  });
+
+  test("does not leak overlay state after the turn ends", () => {
+    beginAkiTurn("turn-1", {
+      turn_context: { system_append: "temporary" },
+    });
+    endAkiTurn("turn-1");
+    expect(applyAkiProviderOverlay(input()).systemPrompt).toBe("base system");
+  });
+
+  test("rejects updates for an inactive turn", () => {
+    expect(() =>
+      updateAkiTurn("missing", { interjection: { user_messages: [] } }),
+    ).toThrow("aki turn is not active");
+  });
+
+  test("captures the actual provider request when enabled", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "aki-api-capture-"));
+    process.env.AKI_API_CALL_CAPTURE = directory;
+    try {
+      beginAkiTurn("turn-capture", {
+        turn_context: { system_append: "<channel-turn>test</channel-turn>" },
+      });
+      const enriched = applyAkiProviderOverlay(input());
+      captureAkiProviderCall({
+        agentId: enriched.agentId,
+        conversationId: enriched.conversationId,
+        model: enriched.agent.model,
+        systemPrompt: enriched.systemPrompt ?? enriched.agent.system,
+        messages: enriched.uiMessages,
+        tools: [],
+      });
+      const raw = await readFile(
+        join(directory, "api-calls-agent-test.jsonl"),
+        "utf8",
+      );
+      const record = JSON.parse(raw.trim()) as Record<string, unknown>;
+      expect(record.system_prompt).toContain("<channel-turn>test</channel-turn>");
+      expect((record.overlay as Record<string, unknown>).turn_id).toBe(
+        "turn-capture",
+      );
+    } finally {
+      delete process.env.AKI_API_CALL_CAPTURE;
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/src/aki/bridge.ts b/src/aki/bridge.ts
new file mode 100644
index 0000000..ac67cbb
--- /dev/null
+++ b/src/aki/bridge.ts
@@ -0,0 +1,264 @@
+/**
+ * Aki bridge state inside the Letta process.
+ *
+ * The bridge is intentionally process-local: akid installs turn-scoped
+ * overlays over stream-json, and the provider request boundary applies them
+ * without persisting anything into the agent conversation.
+ */
+
+import { randomUUID } from "node:crypto";
+import { appendFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+import type { ProviderTurnInput } from "@/backend/dev/provider-turn-executor";
+import type { LocalMessage, LocalUserMessage } from "@/backend/local/local-message";
+
+export interface AkiEphemeralMessage {
+  role?: "user" | "system";
+  content: string | Array<{ type: "text"; text: string }>;
+}
+
+export interface AkiTurnContext {
+  system_append?: string;
+  mid_system_append?: string;
+  user_messages?: AkiEphemeralMessage[];
+}
+
+export interface AkiTurnOverlay {
+  turn_context?: AkiTurnContext;
+  interjection?: { user_messages?: AkiEphemeralMessage[] };
+}
+
+interface AkiTurnState {
+  turnId: string;
+  overlay: AkiTurnOverlay;
+  pendingInterjections: AkiEphemeralMessage[];
+}
+
+let activeTurn: AkiTurnState | null = null;
+
+export function akiBridgeCapabilities(): Record<string, unknown> {
+  return {
+    version: 1,
+    features: [
+      "turn_overlay",
+      "conversation_reload",
+      "conversation_snapshot",
+      "conversation_restore",
+    ],
+  };
+}
+
+function asRecord(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function normalizeOverlay(value: unknown): AkiTurnOverlay {
+  const record = asRecord(value);
+  const turnContext = asRecord(record.turn_context);
+  const interjection = asRecord(record.interjection);
+  return {
+    ...(Object.keys(turnContext).length > 0
+      ? { turn_context: turnContext as AkiTurnContext }
+      : {}),
+    ...(Object.keys(interjection).length > 0
+      ? { interjection: interjection as AkiTurnOverlay["interjection"] }
+      : {}),
+  };
+}
+
+export function beginAkiTurn(turnId: string, overlay: unknown): void {
+  activeTurn = {
+    turnId,
+    overlay: normalizeOverlay(overlay),
+    pendingInterjections: [],
+  };
+}
+
+export function updateAkiTurn(turnId: string, overlay: unknown): void {
+  if (!activeTurn || activeTurn.turnId !== turnId) {
+    throw new Error(`aki turn is not active: ${turnId}`);
+  }
+  const next = normalizeOverlay(overlay);
+  const current = activeTurn.overlay;
+  if (next.interjection?.user_messages?.length) {
+    activeTurn.pendingInterjections.push(...next.interjection.user_messages);
+  }
+  activeTurn.overlay = {
+    ...(current.turn_context || next.turn_context
+      ? {
+          turn_context: {
+            ...(current.turn_context ?? {}),
+            ...(next.turn_context ?? {}),
+          },
+        }
+      : {}),
+  };
+}
+
+export function endAkiTurn(turnId: string): void {
+  if (activeTurn?.turnId === turnId) activeTurn = null;
+}
+
+function appendBlock(current: string | undefined, block: string | undefined): string | undefined {
+  const text = block?.trim();
+  if (!text) return current;
+  return current?.trim() ? `${current.trim()}\n\n${text}` : text;
+}
+
+function contentParts(message: AkiEphemeralMessage): LocalUserMessage["content"] {
+  if (typeof message.content === "string") {
+    return [{ type: "text", text: message.content }];
+  }
+  return message.content;
+}
+
+function makeEphemeralMessage(
+  message: AkiEphemeralMessage,
+  input: ProviderTurnInput,
+): LocalUserMessage {
+  const now = new Date().toISOString();
+  return {
+    id: `aki-overlay-${randomUUID()}`,
+    role: "user",
+    content: contentParts(message),
+    timestamp: Date.now(),
+    metadata: {
+      created_at: now,
+      updated_at: now,
+      agent_id: input.agentId,
+      conversation_id: input.conversationId,
+    },
+  };
+}
+
+/**
+ * Apply the active Aki overlay immediately before a provider request.
+ * turn_context is replayed for every request in the turn; interjections are
+ * consumed once at the next request boundary.
+ */
+export function applyAkiProviderOverlay(input: ProviderTurnInput): ProviderTurnInput {
+  const state = activeTurn;
+  if (!state) return input;
+  const turnContext = state.overlay.turn_context ?? {};
+  const interjections = state.pendingInterjections;
+  state.pendingInterjections = [];
+  const messages = [
+    ...(turnContext.user_messages ?? []),
+    ...interjections,
+  ].map((message) => makeEphemeralMessage(message, input));
+  const systemPrompt = appendBlock(
+    input.systemPrompt ?? input.agent.system,
+    turnContext.system_append,
+  );
+  const midConversationSystemPrompt = appendBlock(
+    input.midConversationSystemPrompt,
+    turnContext.mid_system_append,
+  );
+  if (!messages.length && systemPrompt === input.systemPrompt && midConversationSystemPrompt === input.midConversationSystemPrompt) {
+    return input;
+  }
+  return {
+    ...input,
+    ...(systemPrompt !== undefined ? { systemPrompt } : {}),
+    ...(midConversationSystemPrompt !== undefined
+      ? { midConversationSystemPrompt }
+      : {}),
+    uiMessages: [...input.uiMessages, ...messages] as LocalMessage[],
+  };
+}
+
+export function addAkiInterjection(
+  turnId: string,
+  messages: AkiEphemeralMessage[],
+): void {
+  if (!activeTurn || activeTurn.turnId !== turnId) {
+    throw new Error(`aki turn is not active: ${turnId}`);
+  }
+  activeTurn.pendingInterjections.push(...messages);
+}
+
+export function akiOverlaySnapshot(): Record<string, unknown> | null {
+  if (!activeTurn) return null;
+  return {
+    turn_id: activeTurn.turnId,
+    system_append: activeTurn.overlay.turn_context?.system_append ?? "",
+    mid_system_append:
+      activeTurn.overlay.turn_context?.mid_system_append ?? "",
+    overlay_user_messages:
+      activeTurn.overlay.turn_context?.user_messages ?? [],
+    pending_interjections: activeTurn.pendingInterjections,
+  };
+}
+
+function captureSafe(value: unknown, depth = 0): unknown {
+  if (depth > 12) return "[depth limit]";
+  if (typeof value === "string") {
+    return value.length > 300_000 ? `${value.slice(0, 300_000)}\n...[truncated]` : value;
+  }
+  if (Array.isArray(value)) {
+    return value.map((item) => captureSafe(item, depth + 1));
+  }
+  if (value !== null && typeof value === "object") {
+    const output: Record<string, unknown> = {};
+    for (const [key, child] of Object.entries(value)) {
+      if (
+        key === "data" &&
+        typeof child === "string" &&
+        child.length > 1000
+      ) {
+        output[key] = "[base64 omitted]";
+        continue;
+      }
+      output[key] = captureSafe(child, depth + 1);
+    }
+    return output;
+  }
+  return value;
+}
+
+export function captureAkiProviderCall(input: {
+  agentId: string;
+  conversationId: string;
+  model: string;
+  systemPrompt: string;
+  midConversationSystemPrompt?: string;
+  messages: unknown[];
+  tools: unknown;
+}): void {
+  const directory = process.env.AKI_API_CALL_CAPTURE?.trim();
+  if (!directory) return;
+  try {
+    mkdirSync(directory, { recursive: true, mode: 0o700 });
+    const safeAgent = input.agentId.replace(/[^A-Za-z0-9_.-]/g, "_");
+    const path = join(directory, `api-calls-${safeAgent}.jsonl`);
+    const record = {
+      captured_at: new Date().toISOString(),
+      pid: process.pid,
+      agent_id: input.agentId,
+      conversation_id: input.conversationId,
+      model: input.model,
+      overlay: akiOverlaySnapshot(),
+      system_prompt: input.systemPrompt,
+      mid_conversation_system_prompt:
+        input.midConversationSystemPrompt ?? "",
+      messages: input.messages,
+      tools: input.tools,
+    };
+    appendFileSync(path, `${JSON.stringify(captureSafe(record))}\n`, {
+      mode: 0o600,
+    });
+    console.error(
+      `[aki-api-capture] agent=${input.agentId} turn=${String(
+        (record.overlay as Record<string, unknown> | null)?.turn_id ?? "-",
+      )} messages=${input.messages.length} file=${path}`,
+    );
+  } catch (error) {
+    console.error(
+      `[aki-api-capture] failed: ${
+        error instanceof Error ? error.message : String(error)
+      }`,
+    );
+  }
+}
