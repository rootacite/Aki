+
+describe("sliding-window retention", () => {
+  test("keeps the newest 40% of messages by count", () => {
+    const messages: LocalMessage[] = [
+      user("u1", [{ type: "text", text: "1" }]),
+      assistant("a1", [{ type: "text", text: "2" }]),
+      user("u2", [{ type: "text", text: "3" }]),
+      assistant("a2", [{ type: "text", text: "4" }]),
+      user("u3", [{ type: "text", text: "5" }]),
+      assistant("a3", [{ type: "text", text: "6" }]),
+      user("u4", [{ type: "text", text: "7" }]),
+      assistant("a4", [{ type: "text", text: "8" }]),
+      user("u5", [{ type: "text", text: "9" }]),
+      assistant("a5", [{ type: "text", text: "10" }]),
+    ];
+
+    const plan = planLocalSlidingWindowCompaction(messages);
+
+    expect(plan.cutoffIndex).toBe(6);
+    expect(plan.messagesToSummarize).toHaveLength(6);
+    expect(plan.messagesToKeep).toHaveLength(4);
+    expect(plan.messagesToKeep.map((message) => message.id)).toEqual([
+      "u4",
+      "a4",
+      "u5",
+      "a5",
+    ]);
+  });
+
+  test("backs up when the retention boundary lands on a tool result", () => {
+    const messages: LocalMessage[] = [
+      user("u1", [{ type: "text", text: "1" }]),
+      assistant("a1", [{ type: "text", text: "2" }]),
+      user("u2", [{ type: "text", text: "3" }]),
+      assistant("a2", [{ type: "text", text: "4" }]),
+      user("u3", [{ type: "text", text: "5" }]),
+      assistant("a3", [
+        {
+          type: "toolCall",
+          id: "call-1",
+          name: "Read",
+          arguments: { path: "README.md" },
+        },
+      ]),
+      toolResult("t1", [{ type: "text", text: "README" }]),
+      assistant("a4", [{ type: "text", text: "8" }]),
+      user("u5", [{ type: "text", text: "9" }]),
+      assistant("a5", [{ type: "text", text: "10" }]),
+    ];
+
+    const plan = planLocalSlidingWindowCompaction(messages);
+
+    expect(plan.cutoffIndex).toBe(5);
+    expect(plan.messagesToKeep[0]?.id).toBe("a3");
+    expect(plan.messagesToKeep[1]?.id).toBe("t1");
+    expect(plan.messagesToKeep).toHaveLength(5);
+  });
+});
